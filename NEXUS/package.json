{
  "name": "nexus-desktop",
  "description": "NEXUS: habits, health, finance and journal",
  "author": "CaptainReinor",
  "desktopName": "ru.nexus.desktop.desktop",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:linux": "npm run build && electron-builder --linux AppImage --x64 --config.npmRebuild=true --publish never"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "8.3.1",
    "vitest": "^4.0.16",
    "zod": "4.6.5"
  },
  "build": {
    "appId": "ru.nexus.desktop",
    "productName": "NEXUS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!node_modules/better-sqlite3/src/**/*",
      "!node_modules/better-sqlite3/deps/**/*",
      "!node_modules/better-sqlite3/build/Release/obj/**/*",
      "!node_modules/better-sqlite3/build/Release/sqlite3.lib",
      "!node_modules/better-sqlite3/build/Release/test_extension.node",
      "!**/*.map",
      "assets/nexus-icon.png"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "npmRebuild": false,
    "afterPack": "scripts/after-pack.cjs",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/nexus-icon.ico",
      "artifactName": "NEXUS-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "compression": "maximum",
    "electronLanguages": [
      "en-US",
      "ru"
    ],
    "linux": {
      "syncDesktopName": true,
      "executableArgs": [],
      "target": [
        "AppImage"
      ],
      "icon": "assets/nexus-icon.png",
      "category": "Utility",
      "executableName": "nexus",
      "artifactName": "NEXUS-${version}-linux-x64.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "CaptainReinor",
        "repo": "nexus",
        "releaseType": "release"
      }
    ]
  },
  "license": "MIT"
}
